{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "types": [],
    "paths": {
      "loom:extension/host@0.1.0": ["./generated/interfaces/loom-extension-host.d.ts"],
      "loom:ui/tree@0.1.0": ["./generated/interfaces/loom-ui-tree.d.ts"],
      "@loom/extension": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "example/**/*.ts", "generated/**/*.d.ts"]
}
