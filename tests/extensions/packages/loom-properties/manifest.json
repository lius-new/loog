{
  "schema": 1,
  "id": "loom.properties",
  "version": "0.1.0",
  "name": "Properties",
  "publisher": "Loom",
  "description": "Syntax highlighting and snippets for Java .properties files.",
  "categories": ["Syntax Highlighting", "Snippets"],
  "keywords": ["properties", "java", "config"],
  "license": "MIT",
  "repository": "https://github.com/lius-new/loom",
  "icon": "icon.svg",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "engines": { "loom": "0.1.8" },
  "contributes": {
    "highlight": [
      { "id": "loom.properties.grammar", "path": "grammar/tree-sitter.json" }
    ],
    "snippets": [
      { "id": "loom.properties.snippets", "path": "snippets/properties.json" }
    ]
  }
}
