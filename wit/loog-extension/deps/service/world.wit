package loog:service@0.1.0;

/// What an extension says about the service it runs for documents.
///
/// The host draws it: the status bar icon, the service list and their words and
/// motion belong to the application. An extension only says which state it is in.
/// Nothing crosses to the extension when the state is shown or the list is opened.
interface status {
    enum state {
        /// Not running, by choice or because it ended.
        stopped,
        /// Preparing to answer.
        starting,
        /// Ready and idle.
        ready,
        /// Busy, such as indexing a project.
        working,
        /// It could not run, or stopped running by itself.
        error,
    }

    record report {
        /// Names one running session of the service, such as one workspace folder. A later
        /// report with the same key replaces the earlier one.
        key: string,
        state: state,
        /// One short line about the state, shown in the service list and as a hint.
        detail: option<string>,
        /// The documents it is about, by the `DocumentRef` path; none is every document it serves.
        contexts: option<list<string>>,
    }

    /// Publish or replace one session's report.
    publish: func(report: report) -> result<_, string>;
    /// Remove the report of one session.
    withdraw: func(key: string) -> result<_, string>;
}

/// What a service found in files that are not open, for the Problems panel.
///
/// The findings of an open document stay with that document and follow its
/// edits; this is for the rest of the workspace. A finding names a place the
/// way the service counts it, so the host needs no text to keep it. When the
/// document is open the host shows the document's own findings instead.
interface findings {
    /// How a position's `character` counts the text of its line.
    enum encoding {
        utf8,
        utf16,
    }

    /// Zero-based line and character.
    record position {
        line: u32,
        character: u32,
    }

    record finding {
        start: position,
        end: position,
        /// 1 error, 2 warning, 3 information, 4 hint.
        severity: u8,
        message: string,
        source: option<string>,
        code: option<string>,
    }

    /// Replace what `key` found in the file at the absolute `path`. An empty list
    /// takes the file out. `key` names one session of the service, like a status
    /// report's key.
    publish: func(key: string, path: string, encoding: encoding, items: list<finding>) -> result<_, string>;
    /// Remove everything `key` found. Everything goes too when the extension stops.
    withdraw: func(key: string) -> result<_, string>;
}
