package loom:log@0.1.0;

/// Lines an extension writes for the person to read in the Output panel.
///
/// A channel belongs to the extension that makes it; the application draws the
/// list, the level filter and the words around it. Nothing crosses back to the
/// extension when a channel is shown, filtered or cleared by the person.
interface output {
    enum level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    /// Declare a channel, or rename the one with this key. The key is the
    /// extension's own name for it; the name is what the person sees.
    channel: func(key: string, name: string) -> result<_, string>;
    /// Add one line to a channel that was declared. Text with newlines is split.
    append: func(key: string, level: level, text: string) -> result<_, string>;
    /// Remove every line of a channel.
    clear: func(key: string) -> result<_, string>;
}
