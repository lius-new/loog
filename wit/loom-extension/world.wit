// Candidate contract for Loom behaviour extensions (EXTENSIONS_DESIGN.md §7).
// Status: M0 candidate. Signatures are not frozen until M1-14.
package loom:extension@0.1.0;

interface types {
    /// Half-open UTF-8 byte range.
    record byte-range {
        start: u64,
        end: u64,
    }

    record text-edit {
        range: byte-range,
        text: string,
    }

    enum error-kind {
        unsupported-api,
        permission-denied,
        stale-snapshot,
        expired-handle,
        cancelled,
        deadline-exceeded,
        limit-exceeded,
        conflict,
        invalid-edit,
        extension-failed,
    }

    record host-error {
        kind: error-kind,
        message: string,
        /// True when the operation had already been committed.
        committed: bool,
    }

    /// Host-assigned opaque handles. Each carries workspace, extension,
    /// activation generation and (for rooted operations) root and generation.
    type operation-id = u64;
    type snapshot-token = u64;
    type call-id = u64;

    record selection {
        range: byte-range,
        /// True when the caret is at the start of the range.
        reversed: bool,
    }

    record command-context {
        call: call-id,
        command: string,
        /// Captured target document; absent for commands without one.
        snapshot: option<snapshot-token>,
        selections: list<selection>,
        /// Opaque selection precondition generated by the host.
        selection-precondition: option<u64>,
    }

    record document-edits {
        snapshot: snapshot-token,
        edits: list<text-edit>,
    }

    record apply-edit-request {
        title: string,
        call: call-id,
        /// Per-activation monotonic sequence used as the de-duplication key.
        sequence: u64,
        selection-precondition: option<u64>,
        documents: list<document-edits>,
    }

    /// Terminal state of a host operation.
    variant completion {
        committed(committed-receipt),
        failed(host-error),
    }

    record committed-receipt {
        transaction: u64,
        version: u64,
    }

    /// A document as the extension sees it. `lifecycle` changes every time the
    /// document is opened, so events of an earlier life never apply to a reopened one.
    record document-ref {
        document: u64,
        lifecycle: u64,
        path: string,
        language: string,
        version: u64,
    }

    /// Contiguous change summary; the text is read through a snapshot on demand.
    record document-change {
        document: u64,
        lifecycle: u64,
        from-version: u64,
        to-version: u64,
        edits: u32,
    }

    enum provider-kind {
        diagnostics,
        formatting,
        completion,
        /// Complete one item of an earlier completion answer (documentation, detail).
        completion-resolve,
    }

    /// One completion candidate. `data` is opaque to the host and comes back
    /// unchanged in a resolve request, so the answer is routed to its origin.
    record completion-item {
        label: string,
        detail: option<string>,
        documentation: option<string>,
        /// LSP completion item kind number.
        kind: option<u32>,
        insert-text: option<string>,
        sort-text: option<string>,
        filter-text: option<string>,
        data: option<string>,
    }

    /// A request to a registered provider for one state of a document. The text
    /// is read through `snapshot`; the answer must refer to `request`.
    record provider-request {
        request: u64,
        /// Provider id as declared in the manifest.
        provider: string,
        kind: provider-kind,
        snapshot: snapshot-token,
        document: u64,
        version: u64,
        /// Length in bytes of the snapshot text.
        length: u64,
        /// Restrict a formatting request to this range.
        range: option<byte-range>,
        /// Completion: the caret, and the character that triggered the request.
        cursor: option<u64>,
        trigger: option<string>,
        /// Completion resolve: the item to complete.
        item: option<completion-item>,
    }

    record diagnostic {
        range: byte-range,
        /// 1 error, 2 warning, 3 information, 4 hint.
        severity: u8,
        message: string,
        source: option<string>,
        code: option<string>,
    }

    /// Message pushed by the host into the guest.
    variant inbound {
        provider-request(provider-request),
        run-command(command-context),
        document-opened(document-ref),
        document-changed(document-change),
        /// The incremental stream has a gap; read a new snapshot and rebuild the baseline.
        document-resync(document-ref),
        document-closed(document-ref),
        /// Resolved values of these setting keys changed; read them with `get-setting`.
        settings-changed(list<string>),
        operation-complete(tuple<operation-id, completion>),
        cancel(call-id),
        shutdown,
    }

    /// Result of one scheduling round.
    enum round-status {
        /// No runnable work; callbacks may still be pending on host operations.
        idle,
        /// Pending callbacks wait for host completions.
        pending,
        /// More work is runnable; the host should schedule another round soon.
        runnable,
    }
}

interface host {
    use types.{apply-edit-request, completion-item, diagnostic, host-error, operation-id, snapshot-token, byte-range, text-edit};

    /// Read a bounded range of a captured snapshot. Fast, never blocks on the UI.
    read-range: func(snapshot: snapshot-token, range: byte-range) -> result<string, host-error>;
    release-snapshot: func(snapshot: snapshot-token);

    /// Accept an edit for scheduling. Returning only means "accepted"; the
    /// outcome arrives later as an `operation-complete` message.
    apply-edit: func(request: apply-edit-request) -> result<operation-id, host-error>;

    cancel: func(operation: operation-id);

    /// The resolved value of one of this extension's declared settings, as JSON text.
    get-setting: func(key: string) -> option<string>;

    /// Answer a diagnostics request. Only the latest answer for the document's
    /// current state is shown; an answer for an older state is discarded.
    provide-diagnostics: func(request: u64, items: list<diagnostic>) -> result<_, host-error>;

    /// Answer a completion request (several items) or a resolve request (the
    /// one completed item). `incomplete` asks to be asked again as typing continues.
    provide-completions: func(request: u64, items: list<completion-item>, incomplete: bool) -> result<_, host-error>;

    /// Answer a formatting request with edits against the requested snapshot.
    provide-edits: func(request: u64, edits: list<text-edit>) -> result<_, host-error>;

    log: func(level: u8, message: string);
}

interface guest {
    use types.{inbound, round-status, host-error};

    /// Deliver a batch and advance the guest by one bounded round. The call
    /// must return; it must never wait for a later host delivery.
    dispatch: func(batch: list<inbound>) -> result<round-status, host-error>;
}

world extension {
    import host;
    export guest;
}
