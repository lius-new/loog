// Candidate contract for Loom behaviour extensions (EXTENSIONS_DESIGN.md §7).
// Status: M0 candidate. Signatures are not frozen until M1-14.
package loom:extension@0.1.0;

interface types {
    /// Half-open UTF-8 byte range.
    record byte-range {
        start: u64,
        end: u64,
    }

    record text-edit {
        range: byte-range,
        text: string,
    }

    enum error-kind {
        unsupported-api,
        permission-denied,
        stale-snapshot,
        expired-handle,
        cancelled,
        deadline-exceeded,
        limit-exceeded,
        conflict,
        invalid-edit,
        extension-failed,
    }

    record host-error {
        kind: error-kind,
        message: string,
        /// True when the operation had already been committed.
        committed: bool,
    }

    /// Host-assigned opaque handles. Each carries workspace, extension,
    /// activation generation and (for rooted operations) root and generation.
    type operation-id = u64;
    type snapshot-token = u64;
    type call-id = u64;

    record selection {
        range: byte-range,
        /// True when the caret is at the start of the range.
        reversed: bool,
    }

    record command-context {
        call: call-id,
        command: string,
        /// Captured target document; absent for commands without one.
        snapshot: option<snapshot-token>,
        selections: list<selection>,
        /// Opaque selection precondition generated by the host.
        selection-precondition: option<u64>,
    }

    record document-edits {
        snapshot: snapshot-token,
        edits: list<text-edit>,
    }

    record apply-edit-request {
        title: string,
        call: call-id,
        /// Per-activation monotonic sequence used as the de-duplication key.
        sequence: u64,
        selection-precondition: option<u64>,
        documents: list<document-edits>,
    }

    /// Terminal state of a host operation.
    variant completion {
        committed(committed-receipt),
        failed(host-error),
    }

    record committed-receipt {
        transaction: u64,
        version: u64,
    }

    /// A document as the extension sees it. `lifecycle` changes every time the
    /// document is opened, so events of an earlier life never apply to a reopened one.
    record document-ref {
        document: u64,
        lifecycle: u64,
        path: string,
        language: string,
        version: u64,
    }

    /// Contiguous change summary; the text is read through a snapshot on demand.
    record document-change {
        document: u64,
        lifecycle: u64,
        from-version: u64,
        to-version: u64,
        edits: u32,
    }

    enum provider-kind {
        diagnostics,
        formatting,
        completion,
        /// Complete one item of an earlier completion answer (documentation, detail).
        completion-resolve,
        /// Change a file before it is saved. The snapshot is a temporary copy that
        /// earlier participants already changed; answer with `provide-edits`. While
        /// the request is open, calls with side effects fail with permission-denied.
        save,
        /// Describe the symbol at `cursor`; answer with `provide-hover`.
        hover,
        /// Where the symbol at `cursor` is defined; answer with `provide-locations`.
        definition,
        /// The outline of the document; answer with `provide-symbols`.
        document-symbols,
        /// The signature being called at `cursor`; answer with `provide-signature`.
        signature-help,
        /// Inline hints inside `range` (the whole text when absent); answer with
        /// `provide-inlay-hints`.
        inlay-hints,
    }

    /// Text shown for a symbol, as Markdown, with the part of the text it is about.
    record hover-answer {
        contents: string,
        range: option<byte-range>,
    }

    /// A place in a file: zero-based line and a column counted in UTF-8 bytes.
    record location {
        /// Absolute path, or relative to the folder of the requested document.
        path: string,
        line: u32,
        column: u32,
    }

    /// One entry of an outline. `parent` is the index of the enclosing entry in
    /// the same list, which must come before this one.
    record document-symbol {
        name: string,
        detail: option<string>,
        /// LSP symbol kind number.
        kind: u32,
        /// The whole declaration, and the part to select when it is chosen.
        range: byte-range,
        selection: byte-range,
        parent: option<u32>,
    }

    record parameter-info {
        label: string,
        documentation: option<string>,
    }

    /// The signature of the call being typed and which parameter is current.
    record signature-answer {
        label: string,
        documentation: option<string>,
        parameters: list<parameter-info>,
        active-parameter: option<u32>,
    }

    /// A hint shown in the text at `offset` without being part of it.
    record inlay-hint {
        offset: u64,
        label: string,
        /// 1 type, 2 parameter name; absent for others.
        kind: option<u8>,
        padding-left: bool,
        padding-right: bool,
        tooltip: option<string>,
    }

    /// One completion candidate. `data` is opaque to the host and comes back
    /// unchanged in a resolve request, so the answer is routed to its origin.
    record completion-item {
        label: string,
        detail: option<string>,
        documentation: option<string>,
        /// LSP completion item kind number.
        kind: option<u32>,
        insert-text: option<string>,
        sort-text: option<string>,
        filter-text: option<string>,
        data: option<string>,
    }

    /// A request to a registered provider for one state of a document. The text
    /// is read through `snapshot`; the answer must refer to `request`.
    record provider-request {
        request: u64,
        /// Provider id as declared in the manifest.
        provider: string,
        kind: provider-kind,
        snapshot: snapshot-token,
        document: u64,
        version: u64,
        /// Length in bytes of the snapshot text.
        length: u64,
        /// Restrict a formatting request to this range.
        range: option<byte-range>,
        /// Completion: the caret, and the character that triggered the request.
        cursor: option<u64>,
        trigger: option<string>,
        /// Completion resolve: the item to complete.
        item: option<completion-item>,
    }

    record diagnostic {
        range: byte-range,
        /// 1 error, 2 warning, 3 information, 4 hint.
        severity: u8,
        message: string,
        source: option<string>,
        code: option<string>,
    }

    /// A workspace folder as the extension may name it. Handles change when a
    /// folder is removed and added again.
    record root-ref {
        id: u64,
        name: string,
    }

    type task-id = u64;

    /// Where a stored value lives. `user` is shared by every workspace;
    /// `workspace` belongs to the current set of folders; `root` to one folder.
    variant storage-scope {
        user,
        workspace,
        root(u64),
    }

    record http-response {
        status: u16,
        content-type: option<string>,
        /// The body as text (invalid bytes replaced), at most the bytes asked for.
        body: string,
        truncated: bool,
    }

    record create-op {
        path: string,
        /// Initial content; empty when absent.
        text: option<string>,
        overwrite: bool,
    }

    record rename-op {
        source: string,
        target: string,
        overwrite: bool,
    }

    record delete-op {
        path: string,
        recursive: bool,
    }

    variant file-op {
        create(create-op),
        rename(rename-op),
        delete(delete-op),
    }

    /// File changes done in order inside one folder. They are not one atomic
    /// action on disk: if a step fails the earlier ones are undone, and if the
    /// undo cannot finish the error says where the rest is.
    record file-ops-request {
        call: call-id,
        root: u64,
        ops: list<file-op>,
    }

    record file-content {
        text: string,
        /// The file is longer than the bytes asked for; `text` is its start.
        truncated: bool,
    }

    /// Run a program on the machine, without a shell: `program` and `args` are
    /// the whole command line. `cwd` is relative to the root and may not leave it.
    record task-request {
        call: call-id,
        root: u64,
        program: string,
        args: list<string>,
        cwd: option<string>,
        /// Only a small allow list of names is accepted.
        env: list<tuple<string, string>>,
        timeout-ms: option<u32>,
    }

    enum output-channel {
        stdout,
        stderr,
    }

    record task-output {
        task: task-id,
        channel: output-channel,
        text: string,
        /// Output was cut here because the task produced more than its budget.
        truncated: bool,
    }

    /// Delivered exactly once per started task.
    record task-exit {
        task: task-id,
        code: option<s32>,
        cancelled: bool,
        timed-out: bool,
        output-truncated: bool,
        /// Set instead of running when the request was refused or could not start.
        error: option<host-error>,
    }

    /// Message pushed by the host into the guest.
    variant inbound {
        task-output(task-output),
        task-exited(task-exit),
        provider-request(provider-request),
        run-command(command-context),
        document-opened(document-ref),
        document-changed(document-change),
        /// The incremental stream has a gap; read a new snapshot and rebuild the baseline.
        document-resync(document-ref),
        document-closed(document-ref),
        /// Resolved values of these setting keys changed; read them with `get-setting`.
        settings-changed(list<string>),
        operation-complete(tuple<operation-id, completion>),
        cancel(call-id),
        shutdown,
    }

    /// Result of one scheduling round.
    enum round-status {
        /// No runnable work; callbacks may still be pending on host operations.
        idle,
        /// Pending callbacks wait for host completions.
        pending,
        /// More work is runnable; the host should schedule another round soon.
        runnable,
    }
}

interface host {
    use types.{apply-edit-request, completion-item, diagnostic, document-symbol, file-content, file-ops-request, hover-answer, host-error, http-response, inlay-hint, location, root-ref, signature-answer, storage-scope, task-id, task-request, operation-id, snapshot-token, byte-range, text-edit};

    /// Read a bounded range of a captured snapshot. Fast, never blocks on the UI.
    read-range: func(snapshot: snapshot-token, range: byte-range) -> result<string, host-error>;
    release-snapshot: func(snapshot: snapshot-token);

    /// Accept an edit for scheduling. Returning only means "accepted"; the
    /// outcome arrives later as an `operation-complete` message.
    apply-edit: func(request: apply-edit-request) -> result<operation-id, host-error>;

    cancel: func(operation: operation-id);

    /// Persistent values of this extension, in its own namespace. Writes are
    /// limited in key length, value size, number of keys and total size per scope.
    storage-get: func(scope: storage-scope, key: string) -> option<string>;
    storage-set: func(scope: storage-scope, key: string, value: string) -> result<_, host-error>;
    storage-delete: func(scope: storage-scope, key: string) -> result<_, host-error>;

    /// Read a text file inside a folder, at most `max-bytes` of it. The path is
    /// relative to the folder and may not leave it, directly or through a link.
    read-file: func(root: u64, path: string, max-bytes: u32) -> result<file-content, host-error>;

    /// Relative paths of files in a folder matching a glob (for example
    /// `**/*.rs`), honoring ignore files, at most `limit` of them.
    find-files: func(root: u64, pattern: string, limit: u32) -> result<list<string>, host-error>;

    /// A bounded GET request. Only hosts the manifest declares (and the user
    /// granted) are reachable, every redirect is checked again, and the body is
    /// cut at `max-bytes`.
    http-get: func(url: string, max-bytes: u32) -> result<http-response, host-error>;

    /// Create, rename and delete files inside a folder. Accepted at once; the
    /// outcome arrives as `operation-complete`. A failure with `committed` set
    /// means the disk may be partly changed and the message names where to look.
    apply-file-ops: func(request: file-ops-request) -> result<operation-id, host-error>;

    /// The workspace folders this extension may name.
    list-roots: func() -> list<root-ref>;

    /// Accept a task for scheduling. Refusals (permission, trust, limits) and
    /// the end of the task arrive as `task-exited`; output arrives as `task-output`.
    task-start: func(request: task-request) -> result<task-id, host-error>;

    /// Stop a task and everything it started. The exit is still delivered once.
    task-cancel: func(task: task-id);

    /// Show findings for one state of an open file (for example from a checker).
    /// Findings for a state that is no longer current are discarded.
    publish-diagnostics: func(provider: string, path: string, version: u64, items: list<diagnostic>) -> result<_, host-error>;

    /// The resolved value of one of this extension's declared settings, as JSON text.
    get-setting: func(key: string) -> option<string>;

    /// Answer a diagnostics request. Only the latest answer for the document's
    /// current state is shown; an answer for an older state is discarded.
    provide-diagnostics: func(request: u64, items: list<diagnostic>) -> result<_, host-error>;

    /// Answer a completion request (several items) or a resolve request (the
    /// one completed item). `incomplete` asks to be asked again as typing continues.
    provide-completions: func(request: u64, items: list<completion-item>, incomplete: bool) -> result<_, host-error>;

    /// Answer a formatting request with edits against the requested snapshot.
    provide-edits: func(request: u64, edits: list<text-edit>) -> result<_, host-error>;

    /// Answer a hover request; `none` means there is nothing to show.
    provide-hover: func(request: u64, answer: option<hover-answer>) -> result<_, host-error>;

    /// Answer a definition request with the places the symbol is defined.
    provide-locations: func(request: u64, items: list<location>) -> result<_, host-error>;

    /// Answer an outline request.
    provide-symbols: func(request: u64, items: list<document-symbol>) -> result<_, host-error>;

    /// Answer a signature help request; `none` means there is nothing to show.
    provide-signature: func(request: u64, answer: option<signature-answer>) -> result<_, host-error>;

    /// Answer an inlay hint request with offsets of the requested snapshot.
    provide-inlay-hints: func(request: u64, items: list<inlay-hint>) -> result<_, host-error>;

    log: func(level: u8, message: string);
}

interface guest {
    use types.{inbound, round-status, host-error};

    /// Deliver a batch and advance the guest by one bounded round. The call
    /// must return; it must never wait for a later host delivery.
    dispatch: func(batch: list<inbound>) -> result<round-status, host-error>;
}

world extension {
    import host;
    export guest;
}
