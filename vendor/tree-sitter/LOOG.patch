+    /// LOOG-PATCH(precompiled-wasm): like [`Self::load_language`], but uses
+    /// `compiled`, the output of `wasmtime::Module::serialize` for `bytes`, in
+    /// place of compiling `bytes` in this store's engine.
+    ///
+    /// # Safety
+    ///
+    /// `compiled` must be trusted output of a compatible engine and match `bytes`;
+    /// Wasmtime documents deserializing untrusted modules as undefined behavior.
+    pub unsafe fn load_language_precompiled(
+        &mut self,
+        name: &str,
+        bytes: &[u8],
+        compiled: &[u8],
+    ) -> Result<Language, WasmError> {
+        let name = CString::new(name).unwrap();
+        unsafe {
+            let mut error = MaybeUninit::<ffi::TSWasmError>::uninit();
+            let language = ffi::ts_wasm_store_load_language_precompiled(
+                self.0,
+                name.as_ptr(),
+                bytes.as_ptr().cast::<c_char>(),
+                bytes.len() as u32,
+                compiled.as_ptr().cast::<c_char>(),
+                compiled.len() as u32,
+                error.as_mut_ptr(),
+            );
+            if language.is_null() {
+                Err(WasmError::new(error.assume_init()))
+            } else {
+                Ok(Language(language))
+            }
+        }
+    }
